# Copy to .env and fill in. Never commit .env.
# Every variable the system reads must appear here with a safe placeholder.

# --- general ---------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000      # where the API is reachable
WEB_BASE_URL=http://localhost:5173      # used to build signing links: {WEB_BASE_URL}/sign/{token}
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://foodverse:foodverse@localhost:5432/foodverse_contracts
# used only by pytest; must be a separate database
TEST_DATABASE_URL=postgresql+asyncpg://foodverse:foodverse@localhost:5432/foodverse_contracts_test

# --- object storage (S3-compatible; MinIO locally) -------------------------
S3_ENDPOINT_URL=http://localhost:9000   # leave empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET=foodverse-contracts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true                # true for MinIO, false for AWS

# --- signing ---------------------------------------------------------------
SIGNING_LINK_TTL_DAYS=14                # default link lifetime; per-send override 1..30
DOWNLOAD_URL_TTL_SECONDS=300            # lifetime of pre-signed download URLs
MAX_PDF_BYTES=20971520                  # 20 MB
MAX_SIGNATURE_PNG_BYTES=512000          # 500 KB
PUBLIC_RATE_LIMIT_PER_IP_PER_MINUTE=60
PUBLIC_SIGN_ATTEMPTS_PER_TOKEN=10
CONSENT_TEXT_VERSION=v1

# --- admin auth ------------------------------------------------------------
# Bearer tokens from the internal auth layer. Exact provider is an open
# question in SPEC.md §10; these keys are placeholders for a JWT verifier.
ADMIN_JWT_ISSUER=https://auth.internal.foodverse.example
ADMIN_JWT_AUDIENCE=foodverse-contracts
ADMIN_JWT_JWKS_URL=https://auth.internal.foodverse.example/.well-known/jwks.json
ADMIN_ID_CLAIM=sub

# --- email -----------------------------------------------------------------
EMAIL_PROVIDER=console                  # console (dev: prints to stdout) | smtp
EMAIL_FROM="Foodverse Contracts <contracts@foodverse.example>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- frontend (Vite only exposes VITE_* to the browser) --------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
