# Copy to .env and fill in. Never commit .env.
# Every variable the system reads must appear here with a safe placeholder.
# This service is standalone: no other Foodverse service is called.

# --- general ---------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000      # where the API is reachable
WEB_BASE_URL=http://localhost:5173      # used to build signing links: {WEB_BASE_URL}/sign/{token}
CORS_ALLOWED_ORIGINS=http://localhost:5173
ORG_DISPLAY_NAME=Foodverse              # shown to signers as the sender
DISPLAY_TIMEZONE=Asia/Kathmandu         # human-facing timestamps; UTC is always shown alongside

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://foodverse:foodverse@localhost:5432/foodverse_contracts
# used only by pytest; must be a separate database
TEST_DATABASE_URL=postgresql+asyncpg://foodverse:foodverse@localhost:5432/foodverse_contracts_test
# role used by the retention job; may DELETE from contract_event_pii and UPDATE signers/contracts
RETENTION_DATABASE_URL=postgresql+asyncpg://foodverse_retention:foodverse@localhost:5432/foodverse_contracts

# --- object storage (S3-compatible; MinIO locally) -------------------------
S3_ENDPOINT_URL=http://localhost:9000   # leave empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET=foodverse-contracts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true                # true for MinIO, false for AWS

# --- admin auth (own admins table; first admin via `python -m app.cli create-admin`) ---
JWT_SECRET=change-me-to-at-least-32-random-bytes-base64
JWT_ISSUER=foodverse-contracts
ADMIN_JWT_TTL_MINUTES=480               # 8 hours; no refresh tokens in v1
ADMIN_LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=10
ADMIN_PASSWORD_MIN_LENGTH=12

# --- signing ---------------------------------------------------------------
SIGNING_LINK_TTL_DAYS=14                # default link lifetime; per-send override 1..30
DOWNLOAD_URL_TTL_SECONDS=300            # lifetime of pre-signed download URLs in API responses
MAX_PDF_BYTES=20971520                  # 20 MB
MAX_SIGNATURE_PNG_BYTES=512000          # 500 KB
PUBLIC_RATE_LIMIT_PER_IP_PER_MINUTE=60
PUBLIC_SIGN_ATTEMPTS_PER_TOKEN=10
CONSENT_TEXT_VERSION=v0-draft           # bump when legal approves new wording
CERTIFICATE_TEXT_VERSION=v0-draft

# --- retention (SPEC.md §9; pending legal review) --------------------------
RETENTION_SIGNED_YEARS_AFTER_TERM=7     # used only to compute retain_until; nothing is auto-deleted
RETENTION_UNSIGNED_ANONYMIZE_AFTER_DAYS=90

# --- email (plain SMTP, provider-agnostic; Mailpit locally) ----------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false                      # STARTTLS; set true in production
EMAIL_FROM="Foodverse Contracts <contracts@foodverse.example>"
EMAIL_MAX_ATTACHMENT_BYTES=10485760     # 10 MB; larger signed PDFs are sent as a link instead
EMAIL_DOWNLOAD_LINK_TTL_HOURS=72        # lifetime of pre-signed links embedded in emails

# --- frontend (Vite only exposes VITE_* to the browser) --------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
