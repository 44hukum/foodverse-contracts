{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/worktree-init.sh:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(uv:*)",
      "Bash(alembic:*)",
      "Bash(createdb:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run generate:api:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(npx --yes @redocly/cli lint:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./.venv/**)",
      "Read(./**/.venv/**)",
      "Read(./dist/**)",
      "Read(./**/dist/**)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.*)",
      "Read(./**/*.lock)",
      "Read(./**/package-lock.json)",
      "Read(./**/yarn.lock)",
      "Read(./**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-check.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
